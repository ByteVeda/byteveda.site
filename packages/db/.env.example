# Any Postgres. No provider SDK is involved — RDS, a VPS, a container, or a
# managed pooler all work by changing this one line.
DATABASE_URL=postgresql://user:password@host:5432/database

# require   TLS, certificate verified (production default for a remote host)
# no-verify TLS, certificate not verified (poolers with an untrusted chain)
# disable   no TLS (local only)
# Unset means: disable for localhost, require for everything else.
# DATABASE_SSL=require

# Ceiling on concurrent connections held by one process. Keep it small when a
# pooler sits in front, and when the app runs as serverless functions.
#
# Unset picks the default from the pooler: 5 normally, 2 against Supabase's
# session-mode pooler (port 5432), where each connection is pinned for the life
# of the process and fifteen clients is the limit for the whole database.
# Prefer transaction mode — port 6543 — and leave this alone.
# DATABASE_POOL_MAX=5
