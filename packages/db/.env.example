# Any Postgres. No provider SDK is involved — RDS, a VPS, a container, or a
# managed pooler all work by changing this one line.
DATABASE_URL=postgresql://user:password@host:5432/database

# require   TLS, certificate verified (production default for a remote host)
# no-verify TLS, certificate not verified (poolers with an untrusted chain)
# disable   no TLS (local only)
# Unset means: disable for localhost, require for everything else.
# DATABASE_SSL=require

# Whether this build may apply migrations. The build of every app that reads
# Postgres runs `pnpm --filter @byteveda/db db:deploy` first, so a release and
# its schema arrive together instead of one of them being remembered by hand.
#
# force  apply them, whatever the build thinks it is. For a platform this does
#        not recognise, or a release step that is not a build at all.
# off    never. For a preview environment that shares the production database.
#
# Unset decides by platform: a production deploy migrates, a preview deploy does
# not, and a build on nothing it recognises — CI, a container, a laptop with
# DATABASE_URL exported — is trusted to have chosen its own database.
# DATABASE_MIGRATE=force

# The connection to migrate over, when it should not be the one above. The
# migration holds a session-level advisory lock so that two deploys landing
# together queue rather than collide, and a transaction-mode pooler cannot hold
# one. Supabase's 6543 is moved to 5432 automatically; anything else that pools
# by transaction needs this set to a session or direct connection.
# DATABASE_MIGRATE_URL=postgresql://user:password@host:5432/database

# Ceiling on concurrent connections held by one process. Keep it small when a
# pooler sits in front, and when the app runs as serverless functions.
#
# Unset picks the default from the pooler: 5 normally, 2 against Supabase's
# session-mode pooler (port 5432), where each connection is pinned for the life
# of the process and fifteen clients is the limit for the whole database.
# Prefer transaction mode — port 6543 — and leave this alone.
# DATABASE_POOL_MAX=5

# How long an unused connection stays in the pool before it is closed. This is
# the only thing that keeps a connection open once a request is finished — no
# code here checks a client out by hand, so a request cannot leak one.
#
# Default 2000ms: long enough that the queries of one page render, and the click
# after it, reuse the same connection; short enough that a warm serverless
# instance serving nobody is not sitting on a pooler slot. Lower it if the
# ceiling is tight, at the cost of a TLS handshake per burst.
#
# 0 is ignored, on purpose. node-postgres reads it as "never disconnect an idle
# client" rather than "disconnect it at once", so the obvious way to ask for the
# shortest possible hold is in fact the way to hold connections forever.
#
# Prove whichever value you pick: packages/db/scripts/verify-pool.ts checks both
# the pool's counters and pg_stat_activity.
# DATABASE_POOL_IDLE_MS=2000
