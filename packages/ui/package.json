{
  "name": "@byteveda/ui",
  "version": "0.1.0",
  "type": "module",
  "description": "Shared ByteVeda design system: primitives, theme tokens, and hero effects.",
  "license": "MIT",
  "homepage": "https://github.com/ByteVeda/byteveda.site/tree/main/packages/ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ByteVeda/byteveda.site.git",
    "directory": "packages/ui"
  },
  "bugs": "https://github.com/ByteVeda/byteveda.site/issues",
  "keywords": [
    "byteveda",
    "design-system",
    "react",
    "nextjs",
    "tailwindcss"
  ],
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles/*": "./src/styles/*"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./styles/*": "./dist/styles/*"
    },
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "catalog:"
  },
  "peerDependencies": {
    "next": ">=16",
    "next-themes": ">=0.4",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@byteveda/config": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "next": "catalog:",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "^0.23.0",
    "typescript": "catalog:"
  }
}
