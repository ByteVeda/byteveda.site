{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "extends": ["./packages/config/biome.base.json"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "apps/**",
      "packages/**",
      "*.ts",
      "*.tsx",
      "*.mjs",
      "*.js",
      "*.json",
      "!**/.next",
      "!**/node_modules",
      "!**/next-env.d.ts",
      "!pnpm-lock.yaml",
      "!apps/main/src/features/news/data/news.json"
    ]
  }
}
