{
  "name": "byteveda",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@byteveda/main",
    "dev:docs": "turbo run dev --filter=@byteveda/docs",
    "dev:flexiq": "turbo run dev --filter=@byteveda/flexiq-site",
    "dev:all": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "fetch:news": "pnpm --filter @byteveda/main fetch:news"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "turbo": "^2.10.12",
    "typescript": "^6"
  }
}
