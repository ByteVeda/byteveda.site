{
  "name": "byteveda",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@byteveda/main",
    "dev:docs": "turbo run dev --filter=@byteveda/docs",
    "dev:all": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "typecheck": "turbo run typecheck",
    "fetch:news": "pnpm --filter @byteveda/main fetch:news"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "turbo": "^2.10.8",
    "typescript": "^6"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.10": ">=8.5.10"
    }
  }
}
