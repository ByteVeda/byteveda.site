{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["pnpm-workspace.yaml", "packages/config/**"],
  "tasks": {
    "build": {
      "outputs": [".next/**", "!.next/cache/**", "out/**"],
      // Inlined into the client bundle at build time, so they belong in the hash:
      // a different endpoint, or a build that is not on Vercel, is a different
      // build. Strict env mode would otherwise strip both.
      // FlexiQ prerenders its blog from Postgres, so the connection is part of
      // what the output depends on — a different database is a different build.
      "env": [
        "NEXT_PUBLIC_VITALS_ENDPOINT",
        "NEXT_PUBLIC_VERCEL_ENV",
        "DATABASE_URL",
        "DATABASE_SSL"
      ],
      // Read per request, never during the build, so they cannot change the
      // output and do not belong in the hash above — rotating a secret should
      // not invalidate every cached build. They are declared all the same:
      // strict env mode hides anything undeclared, and Vercel warns about
      // project variables that turbo would drop.
      "passThroughEnv": [
        "ADMIN_URL",
        "ADMIN_GITHUB_IDS",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "REVALIDATE_SECRET",
        "FLEXIQ_URL",
        "CRON_SECRET",
        "PEPY_API_KEY",
        "RESEND_API_KEY",
        "RESEND_WEBHOOK_SECRET",
        "REDIS_URL"
      ]
    },
    "typecheck": {},
    // Playwright builds and serves FlexiQ, which reads the blog from Postgres.
    // Strict env mode would otherwise hand the build an empty database.
    "test": {
      "env": ["DATABASE_URL", "DATABASE_SSL"]
    },
    "lighthouse": {
      "dependsOn": ["build"],
      // Starts a server and uploads a report; there is nothing here to replay.
      "cache": false,
      "passThroughEnv": ["LHCI_*", "CHROME_PATH", "CI"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      // scripts/dev-stack.sh sets the port it told you to point ngrok at.
      "passThroughEnv": ["ADMIN_PORT"]
    },
    "fetch:news": {
      "cache": false
    }
  }
}
