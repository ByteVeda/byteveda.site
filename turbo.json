{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["pnpm-workspace.yaml", "packages/config/**"],
  "tasks": {
    "build": {
      "outputs": [".next/**", "!.next/cache/**", "out/**"],
      // Inlined into the client bundle at build time, so it belongs in the hash:
      // a different endpoint is a different build.
      "env": ["NEXT_PUBLIC_VITALS_ENDPOINT"]
    },
    "typecheck": {},
    "test": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "fetch:news": {
      "cache": false
    }
  }
}
