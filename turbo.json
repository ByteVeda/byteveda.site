{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["pnpm-workspace.yaml", "packages/config/**"],
  "tasks": {
    "build": {
      "outputs": [".next/**", "!.next/cache/**", "out/**"]
    },
    "typecheck": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "fetch:news": {
      "cache": false
    }
  }
}
