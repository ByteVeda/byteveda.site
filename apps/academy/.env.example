# Sample requests. POST /api/orders is the only thing that reads these, and it
# reads them per request — a missing value fails the request, never the build.

# Full-access or sending key from https://resend.com/api-keys. Without it
# POST /api/orders answers 503 and tells the visitor to email us instead.
RESEND_API_KEY=

# Where the one-free-sample-per-address rule is kept. A unique constraint on
# academy.sample_requests.email is the enforcement, so without a database the
# route refuses rather than hand out a second sheet. Use the transaction-mode
# pooler (port 6543) on Vercel; keep 5432 for `pnpm --filter @byteveda/db db:migrate`.
DATABASE_URL=

# Sender for both the work order and the visitor's receipt. Must be an address
# on a domain verified in Resend. Defaults to "ByteVeda Academy <academy@byteveda.org>".
# ACADEMY_ORDER_FROM=ByteVeda Academy <academy@byteveda.org>

# Where the work order lands — this inbox is the order book until payments
# exist. Defaults to hello@byteveda.org.
# ACADEMY_ORDER_INBOX=orders@byteveda.org
