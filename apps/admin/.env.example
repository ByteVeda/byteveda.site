# ---- database -------------------------------------------------------------
# Any Postgres. See packages/db/.env.example for the SSL and pool settings.
DATABASE_URL=postgresql://user:password@host:5432/database
# DATABASE_SSL=require

# ---- sign-in --------------------------------------------------------------
# A GitHub OAuth app: https://github.com/settings/developers
# Authorization callback URL must be <origin>/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Who may sign in, as numeric GitHub user IDs, comma separated.
# Find yours with: curl -s https://api.github.com/users/<login> | jq .id
# Numeric because a login can be renamed and the freed name re-registered.
ADMIN_GITHUB_IDS=

# Only needed when the public origin differs from the request's own — behind a
# proxy that rewrites Host, for instance. Otherwise leave it unset.
# ADMIN_URL=https://admin.byteveda.org

# ---- publishing ------------------------------------------------------------
# Shared with the FlexiQ site. Publishing a post posts this as a bearer token to
# <FLEXIQ_URL>/api/revalidate. Unset means posts still publish, but the site
# waits for its own hourly revalidation to notice.
REVALIDATE_SECRET=
# FLEXIQ_URL=https://flexiq.byteveda.org

# ---- mail ------------------------------------------------------------------
# Sends confirmations, broadcasts and inbox replies. Unset means every send
# reports "RESEND_API_KEY is not set" rather than failing silently.
RESEND_API_KEY=

# Signs the inbound webhook at /api/webhooks/resend, which is what authenticates
# it — the route is outside the cookie gate because the caller is Resend.
# Unset means every delivery is rejected.
RESEND_WEBHOOK_SECRET=
#
# Note: `email.received` is a notification, not the message. The console fetches
# the body with GET /emails/receiving/{id}, which needs RESEND_API_KEY above —
# a webhook secret on its own gives you an inbox of empty conversations.

# ---- live updates ----------------------------------------------------------
# Redis pub/sub carries "the list changed" between server instances, so a
# confirmation handled by one instance reaches a console page held open by
# another. Any Redis speaks the protocol: Upstash, Railway, a container.
#
# Also what carries "mail arrived" from the webhook to an open Inbox: without
# it, the page that shows the mail and the function that received it are
# different instances and never meet.
#
# Unset is fine for a single process — announcements stay in-memory, which is
# what local development runs on.
# REDIS_URL=rediss://default:password@host:6379

# ---- download stats --------------------------------------------------------
# Vercel Cron sends this as a bearer token to /api/cron/stats. Unset means the
# route rejects everything, including Vercel.
CRON_SECRET=

# Optional. pypistats supplies the daily numbers without a key; pepy.tech adds
# an all-time total per PyPI package, and needs one.
# PEPY_API_KEY=
