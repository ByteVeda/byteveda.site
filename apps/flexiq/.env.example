# Blog posts live in Postgres and are written by the admin console. The same
# connection string the admin app uses; see packages/db/.env.example.
DATABASE_URL=postgresql://user:password@host:5432/database
# DATABASE_SSL=require

# Shared with the admin app. It calls /api/revalidate with this as a bearer
# token when a post is published or changed. Without it, that route rejects
# everything and the site falls back to its hourly revalidation.
REVALIDATE_SECRET=
